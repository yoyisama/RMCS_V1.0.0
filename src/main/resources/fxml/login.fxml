<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<!-- 水平布局：左侧品牌区自适应填充，右侧表单区恒定宽度。
     使用 HBox 而非 BorderPane——BorderPane 会对无法填满的 center 子节点做居中处理，
     空间不足时还会把 right 子节点推出窗口右缘（正是登录页显示不全的成因）。 -->
<HBox fx:id="root" styleClass="login-root" stylesheets="@../css/login.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rmcs.controller.LoginController">

    <!-- ================= 左侧品牌区（蓝色渐变，自适应填充） ================= -->
    <VBox styleClass="brand-side" spacing="14" HBox.hgrow="ALWAYS" minWidth="280">
        <padding>
            <Insets top="36" left="42" right="38" bottom="24"/>
        </padding>

        <HBox styleClass="version-pill" alignment="CENTER_LEFT" spacing="6">
            <Label text="⚙"/>
            <Label text="RMCS-RESISTOR v1.0.0.0"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS" minHeight="10"/>

        <Label text="自动测阻机&#10;数字控制中心" styleClass="brand-title" wrapText="true"/>
        <Label text="高精度7行3区阻值自动巡检、PLC联动步进与工业公差智能判定平台"
               styleClass="brand-desc" wrapText="true"/>

        <Region VBox.vgrow="ALWAYS" minHeight="10"/>

        <VBox spacing="12">
            <HBox styleClass="diag-item" alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="diag-dot"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="PLC 逻辑控制器" styleClass="diag-title"/>
                    <Label text="192.168.1.10:502 待命" styleClass="diag-sub"/>
                </VBox>
                <Label text="✓" styleClass="diag-check"/>
            </HBox>
            <HBox styleClass="diag-item" alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="diag-dot"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="高精度微欧计串口" styleClass="diag-title"/>
                    <Label text="COM4 · 9600bps 8-N-1" styleClass="diag-sub"/>
                </VBox>
                <Label text="✓" styleClass="diag-check"/>
            </HBox>
            <HBox styleClass="diag-item" alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="diag-dot"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="校准基准与判定库" styleClass="diag-title"/>
                    <Label text="基准 6.532Ω (±0.010Ω)" styleClass="diag-sub"/>
                </VBox>
                <Label text="✓" styleClass="diag-check"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" minHeight="10"/>

        <Label text="© 2026 RMCS Precision Electronics. All Rights Reserved." styleClass="copyright"/>
    </VBox>

    <!-- ================= 右侧表单区（白色，宽度恒定 400~520） ================= -->
    <VBox styleClass="form-side" minWidth="400" prefWidth="520" maxWidth="520" spacing="8">
        <padding>
            <Insets top="54" left="58" right="58" bottom="40"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="🛡" styleClass="eyebrow-icon"/>
            <Label text="操作员安全认证" styleClass="form-eyebrow"/>
        </HBox>
        <Label text="登入系统控制台" styleClass="form-title"/>
        <Label text="请输入工号凭证以进入自动测阻机在线控制与调度界面" styleClass="form-sub" wrapText="true"/>

        <Region minHeight="18"/>

        <Label text="用户工号 (Username)" styleClass="form-label"/>
        <HBox styleClass="field-wrap" alignment="CENTER_LEFT" spacing="10">
            <Label text="👤" styleClass="field-icon"/>
            <TextField fx:id="accountField" styleClass="field-input" promptText="请输入账号" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Region minHeight="8"/>

        <Label text="授权密码 (Password)" styleClass="form-label"/>
        <HBox styleClass="field-wrap" alignment="CENTER_LEFT" spacing="10">
            <Label text="🔒" styleClass="field-icon"/>
            <PasswordField fx:id="passwordField" styleClass="field-input" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="tfPwdVisible" styleClass="field-input" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnShowPwd" text="👁" styleClass="eye-btn" onAction="#togglePassword"/>
        </HBox>

        <Region minHeight="16"/>

        <HBox styleClass="quick-fill" alignment="CENTER_LEFT" spacing="8">
            <Label text="初始凭证:" styleClass="quick-label"/>
            <Label text="admin" styleClass="code-text"/>
            <Label text="/" styleClass="quick-label"/>
            <Label text="123456" styleClass="code-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✦ 一键填入" styleClass="link-btn" onAction="#fillDefault"/>
        </HBox>

        <Region minHeight="12"/>

        <Button fx:id="btnLogin" text="进入控制系统 →" styleClass="btn-login" onAction="#onLogin"
                maxWidth="Infinity" prefHeight="48"/>

        <Button fx:id="btnReset" text="重  置" styleClass="btn-reset" onAction="#onReset"
                maxWidth="Infinity" prefHeight="42"/>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
