<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" styleClass="main-root" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rmcs.controller.MainController">

    <top>
        <BorderPane fx:id="appHeader" styleClass="app-header">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="app-logo">
                        <Label styleClass="app-logo-text" text="R"/>
                    </StackPane>
                    <Label styleClass="app-logo-name" text="RMCS"/>
                </HBox>
            </left>
            <center>
                <Label styleClass="app-title" text="自动测阻机控制系统"/>
            </center>
            <right>
                <HBox alignment="CENTER" spacing="14">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label styleClass="mode-label" text="自动模式"/>
                        <HBox alignment="CENTER_RIGHT" spacing="4">
                            <Label styleClass="user-label" text="当前用户"/>
                            <Label styleClass="user-name" text="管理员"/>
                        </HBox>
                    </VBox>
                    <Button fx:id="btnFullScreen" styleClass="btn-fullscreen" text="⛶"
                            onAction="#onToggleFullScreen">
                        <tooltip>
                            <Tooltip text="全屏显示（F11）"/>
                        </tooltip>
                    </Button>
                    <Button fx:id="btnPower" styleClass="btn-power" text="⏻" onAction="#onPower"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="24">
            <padding>
                <Insets left="14" right="14"/>
            </padding>
            <Label styleClass="status-ok" text="PLC通讯: 已连接"/>
            <Label styleClass="status-ok" text="电阻计通讯: 已连接"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="status-text" text="版本号: 0.0.0.2"/>
            <Label fx:id="lblDateTime" styleClass="status-text" text="当前日期: --"/>
        </HBox>
    </bottom>

    <center>
        <GridPane styleClass="work-area" hgap="8" vgap="8">
            <padding>
                <Insets top="8" right="8" left="8" bottom="4"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="400" prefWidth="420" maxWidth="420"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="300"/>
                <ColumnConstraints minWidth="226" prefWidth="226" maxWidth="226"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" percentHeight="62"/>
                <RowConstraints vgrow="ALWAYS" percentHeight="38"/>
            </rowConstraints>

            <VBox styleClass="panel" spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <padding>
                    <Insets top="6" right="8" bottom="8" left="8"/>
                </padding>
                <Label styleClass="panel-title" text="执行作业"/>
                <GridPane fx:id="jobGrid" hgap="5" vgap="5" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox styleClass="panel" spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <padding>
                    <Insets top="6" right="8" bottom="8" left="8"/>
                </padding>
                <Label styleClass="panel-title" text="数据履历"/>
                <TableView fx:id="dataTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRow" text="行号" prefWidth="55" minWidth="40"/>
                        <TableColumn fx:id="colPos" text="位置" prefWidth="55" minWidth="40"/>
                        <TableColumn fx:id="colMeasured" text="测量值" prefWidth="85" minWidth="60"/>
                        <TableColumn fx:id="colStandard" text="标准值" prefWidth="85" minWidth="60"/>
                        <TableColumn fx:id="colResult" text="结果" prefWidth="70" minWidth="50"/>
                        <TableColumn fx:id="colTime" text="检测时间" prefWidth="130" minWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text=""/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox styleClass="panel" spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0"
                  GridPane.columnSpan="2">
                <padding>
                    <Insets top="6" right="8" bottom="8" left="8"/>
                </padding>
                <Label styleClass="panel-title" text="动作履历"/>
                <TextArea fx:id="actionLog" styleClass="action-log" editable="false" wrapText="true"
                          VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.rowSpan="2">
                <VBox styleClass="panel" spacing="6">
                    <padding>
                        <Insets top="6" right="8" bottom="8" left="8"/>
                    </padding>
                    <Label styleClass="panel-title" text="测定标准"/>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="92" prefWidth="92"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60"/>
                        </columnConstraints>
                        <Label styleClass="side-label" text="标准值:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label styleClass="side-value" text="6.532" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label styleClass="side-label" text="上偏差:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label styleClass="side-value" text="0.01" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label styleClass="side-label" text="下偏差:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label styleClass="side-value" text="0.01" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Button fx:id="btnParam" styleClass="btn-param" text="参数设定"
                                onAction="#onParam" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                GridPane.columnSpan="2" maxWidth="Infinity"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="panel" spacing="6">
                    <padding>
                        <Insets top="6" right="8" bottom="8" left="8"/>
                    </padding>
                    <Label styleClass="panel-title" text="运行状况"/>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="92" prefWidth="92"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60"/>
                        </columnConstraints>
                        <Label styleClass="side-label" text="完成数量:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCount" styleClass="side-value" text="8,921"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label styleClass="side-label" text="设备运行状况:" GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>
                        <Label fx:id="lblRunState" styleClass="side-value" text="运行中"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label styleClass="side-label" text="运行时长:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDuration" styleClass="side-value" text="10000"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Button fx:id="btnClear" styleClass="btn-param" text="清零"
                                onAction="#onClearRun" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                GridPane.columnSpan="2" maxWidth="Infinity"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="panel" spacing="10" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="6" right="8" bottom="8" left="8"/>
                    </padding>
                    <Label styleClass="panel-title" text="人员操作"/>
                    <GridPane hgap="8" vgap="8" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                            <RowConstraints vgrow="ALWAYS"/>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>
                        <Button fx:id="btnStop" styleClass="op-btn, op-stop" text="设备停止"
                                onAction="#onDeviceStop" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                        <Button fx:id="btnDevReset" styleClass="op-btn, op-gray" text="设备复位"
                                onAction="#onDeviceReset" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                        <Button fx:id="btnStart" styleClass="op-btn, op-start" text="设备启动"
                                onAction="#onDeviceStart" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                        <Button fx:id="btnHistory" styleClass="op-btn, op-blue" text="履历查询"
                                onAction="#onHistoryQuery" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                        <Button fx:id="btnLogQuery" styleClass="op-btn, op-orange" text="日志查询"
                                onAction="#onLogQuery" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                        <Button fx:id="btnExport" styleClass="op-btn, op-purple" text="导出数据"
                                onAction="#onExportData" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                maxWidth="Infinity" maxHeight="Infinity"/>
                    </GridPane>
                </VBox>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
