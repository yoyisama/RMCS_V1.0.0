<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 根：StackPane 承载主题样式类；BorderPane 直接填充整个场景 -->
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rmcs.controller.MainController"
           stylesheets="@../css/main.css" styleClass="root-light">

    <BorderPane styleClass="bg-app">

        <top>
            <fx:include fx:id="header" source="header.fxml"/>
        </top>

        <center>
            <!-- 水平布局：工作区自适应，右面板固定宽度（代码中按屏幕动态调整 330~360） -->
            <HBox fx:id="mainAnchor" styleClass="bg-app" spacing="8" style="-fx-padding: 8 4 4 8;"
                  minWidth="700">
                <!-- 左侧工作区 -->
                <VBox fx:id="workspace" spacing="8" HBox.hgrow="ALWAYS" minWidth="380">
                    <HBox spacing="8" VBox.vgrow="ALWAYS">
                        <fx:include fx:id="workMatrix" source="components/work_matrix.fxml"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="200"/>
                        <fx:include fx:id="dataHistory" source="components/data_history.fxml"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="200"/>
                    </HBox>
                    <fx:include fx:id="actionLog" source="components/action_log.fxml"
                                VBox.vgrow="ALWAYS" maxWidth="Infinity" minHeight="120" prefHeight="170"/>
                </VBox>
                <!-- 右侧控制面板：宽度由代码维护，高度强制等于视口（fitToHeight），
                     配合右面板内 VBox.vgrow 分配空间，保证四张卡片完整显示、不产生滚动 -->
                <ScrollPane fx:id="rightScroll" fitToWidth="true" fitToHeight="true"
                            minWidth="330" prefWidth="360" maxWidth="360"
                            styleClass="bg-app" HBox.hgrow="NEVER">
                    <fx:include fx:id="rightPanel" source="components/right_panel.fxml"/>
                </ScrollPane>
            </HBox>
        </center>

        <bottom>
            <fx:include fx:id="footerBar" source="footer_bar.fxml"/>
        </bottom>
    </BorderPane>
</StackPane>
